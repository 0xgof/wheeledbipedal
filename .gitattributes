# Enforce LF for ROS / shell / source files so the WSL (Linux) build and launch
# scripts always see Unix line endings, regardless of the Windows checkout.
*.sh           text eol=lf
*.bash         text eol=lf
*.py           text eol=lf
*.xml          text eol=lf
*.yaml         text eol=lf
*.yml          text eol=lf
*.xacro        text eol=lf
*.urdf         text eol=lf
*.sdf          text eol=lf
*.rviz         text eol=lf
*.launch       text eol=lf
CMakeLists.txt text eol=lf
